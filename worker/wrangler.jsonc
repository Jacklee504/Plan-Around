{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "planaround-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_BASE_URL": "https://api.featherless.ai/v1",
    "AI_MODEL": "Qwen/Qwen3.5-9B",
    "ALLOWED_PRODUCTION_ORIGIN": "https://jacklee504.github.io"
  },
  "secrets": {
    "required": ["FEATHERLESS_API_KEY"]
  },
  "ratelimits": [
    {
      "name": "ANALYZE_CLIENT_RATE_LIMITER",
      "namespace_id": "9821001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "ANALYZE_GLOBAL_RATE_LIMITER",
      "namespace_id": "9821002",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
