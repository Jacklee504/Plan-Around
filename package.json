{
  "name": "planaround",
  "version": "1.0.0",
  "description": "PlanAround helps students fit assignments around their actual week.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "ai:local": "tsx scripts/localAnalyzer.ts",
    "typecheck": "tsc --noEmit",
    "worker:types": "wrangler types worker/worker-configuration.d.ts --config worker/wrangler.jsonc",
    "worker:types:check": "wrangler types worker/worker-configuration.d.ts --config worker/wrangler.jsonc --check",
    "worker:typecheck": "tsc --project worker/tsconfig.json --noEmit",
    "verify:release": "npm test && npm run lint && npm run typecheck && npm run build && npm run worker:types:check && npm run worker:typecheck",
    "smoke:production": "tsx scripts/productionSmoke.ts",
    "preflight:provider": "tsx scripts/providerPreflight.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
